{% doc %}
  Loads the Acer storefront stylesheet, script and font.

  The font is the same Noto Sans variable file (Google Fonts v42, latin subset, weights 100–900)
  that store.acer.com uses, self-hosted so glyphs and metrics match the original site exactly.
  It gets its own family name so it never merges with the theme's Shopify-library Noto Sans faces.
{% enddoc %}
{%- assign acer_font_url = 'acer-noto-sans-latin.woff2' | asset_url -%}
{{ acer_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{% style %}
  @font-face {
    font-family: 'Acer Noto Sans';
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 100%;
    font-display: swap;
    src: url('{{ acer_font_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
{% endstyle %}
{{ 'acer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'acer.js' | asset_url }}" defer="defer"></script>
